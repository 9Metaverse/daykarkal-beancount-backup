option "inferred_tolerance_default" "*:0.001"

; Currency settings
option "operating_currency" "HKD"
; Currency Commodity
2020-11-12 commodity HKD
  name: "HKD"
  precision: 2

2020-11-12 commodity CNY
  name: "CNY"
  precision: 2

2020-11-12 commodity USD
  name: "USD"
  precision: 2

2020-11-12 commodity JPY
  name: "JPY"
  precision: 2

2020-11-12 commodity USDT
  name: "USDT"
  precision: 2

2020-11-12 commodity XAU
  name: "Gold"
  precision: 2


option "title" "DKK"
2020-11-12 custom "fava-option" "fiscal-year-end" "03-31"
2020-11-12 custom "fava-option" "invert-income-liabilities-equity" "True"


include "currency.beancount"

include "accounts.beancount"

; Manual journal entries (for accountants)
include "manual-journal.beancount"

; Mixed transactions by month
include "mixed/2021-02.beancount"
include "mixed/2021-03.beancount"
include "mixed/2021-04.beancount"
include "mixed/2021-05.beancount"
include "mixed/2021-06.beancount"
include "mixed/2021-07.beancount"
include "mixed/2021-08.beancount"
include "mixed/2021-09.beancount"
