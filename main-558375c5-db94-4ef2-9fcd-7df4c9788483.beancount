option "inferred_tolerance_default" "*:0.001"
option "inferred_tolerance_default" "USDT:0.000001"
option "inferred_tolerance_default" "HKD:0.01"
option "inferred_tolerance_default" "CNY:0.001"
option "inferred_tolerance_default" "USD:0.001"
option "inferred_tolerance_default" "JPY:0.0001"

; Currency settings
option "operating_currency" "HKD"
; Currency Commodity
2020-11-12 commodity USDT
  name: "USDT"
  precision: 6

2020-11-12 commodity HKD
  name: "HKD"
  precision: 2

2020-11-12 commodity CNY
  name: "CNY"
  precision: 3

2020-11-12 commodity USD
  name: "USD"
  precision: 3

2020-11-12 commodity JPY
  name: "JPY"
  precision: 4

2020-11-12 commodity XAU
  name: "Gold"
  precision: 2


option "title" "Day Karkal Limited"
2020-11-12 custom "fava-option" "fiscal-year-end" "03-31"
2020-11-12 custom "fava-option" "invert-income-liabilities-equity" "True"


include "currency.beancount"

include "accounts.beancount"

; Opening balances carried forward from archival cutoff
include "opening.beancount"

; Manual journal entries (for accountants)
include "manual-journal.beancount"

; Mixed transactions by month
include "mixed/2025-04.beancount"
include "mixed/2025-05.beancount"
include "mixed/2025-06.beancount"
include "mixed/2025-07.beancount"
include "mixed/2025-08.beancount"
include "mixed/2025-09.beancount"
include "mixed/2025-10.beancount"
include "mixed/2025-11.beancount"
include "mixed/2025-12.beancount"
include "mixed/2026-01.beancount"
include "mixed/2026-02.beancount"
include "mixed/2026-03.beancount"
